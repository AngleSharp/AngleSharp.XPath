<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.10</Version>
    <AssemblyVersion>2.0.10</AssemblyVersion>
    <FileVersion>2.0.10</FileVersion>
    <Authors>Denis Ivanov</Authors>
    <PackageId>AngleSharp.XPath</PackageId>
    <AssemblyName>AngleSharp.XPath</AssemblyName>
    <RootNamespace>AngleSharp.XPath</RootNamespace>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>XPath support for AngleSharp</Description>
    <PackageProjectUrl>https://anglesharp.github.io/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AngleSharp/AngleSharp.XPath</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>HTML XPath AngleSharp</PackageTags>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Key.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublicSign>True</PublicSign>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' != 'netstandard2.0' And !$(TargetFramework.StartsWith('net4')) ">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- IsAotCompatible makes the SDK reference Microsoft.NET.ILLink.Tasks implicitly, at the version
       its KnownILLinkPack table lists per target (8.0.x for net8.0, 10.0.x for net10.0). Two versions
       of one package in one project make Visual Studio's NuGet Consolidate tab report it, so every
       target uses the trimmer of the SDK doing the build instead. Following the SDK's bundled version
       keeps it current without pinning, and covers the next pair of targets too (net10.0 next to net11.0).
       KnownILLinkPack is SDK-internal and undocumented: if an SDK renames or reshapes it, this goes
       inert or fails the restore - drop it then, or once only one .NETCoreApp target is left. -->
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="$(BundledNETCoreAppPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <DelaySign>false</DelaySign>
  </PropertyGroup>
</Project>
